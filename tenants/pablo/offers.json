      box-shadow: 0 10px 30px -12px rgba(35, 23, 18, 0.08);
    }
    .kraft-texture {
      background-color: #E6CCA8;
      background-image:
        radial-gradient(rgba(140, 98, 57, 0.10) 1px, transparent 0),
        radial-gradient(rgba(255, 253, 249, 0.25) 1px, transparent 0);
      background-size: 20px 20px;
      background-position: 0 0, 10px 10px;
    }
    .swatch-card {
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .swatch-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 12px 24px -10px rgba(35, 23, 18, 0.16);
    }
    .phone-frame {
      border-radius: 38px;
      border: 8px solid #231712;
      box-shadow: 0 24px 50px -15px rgba(35, 23, 18, 0.28);
      overflow: hidden;
      transition: background-color 0.25s ease, color 0.25s ease, border-color 0.25s ease;
    }
    .phone-scroll::-webkit-scrollbar {
      width: 4px;
      height: 4px;
    }
    .phone-scroll::-webkit-scrollbar-thumb {
      background: rgba(156, 133, 115, 0.35);
      border-radius: 999px;
    }
    .toast-enter {
      animation: toastSlide 0.22s ease forwards;
    }
    @keyframes toastSlide {
      from { opacity: 0; transform: translateY(12px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
