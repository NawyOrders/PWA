# NawyOrders tenant API — all three are optional.
#
# With no API_BASE_URL the app is deliberately inert: every screen keeps using
# the local demo data in src/lib/data.ts and the login flow stays a pure
# front-end demo. Nothing is fetched and no token is stored.

# Base URL of the tenant API, no trailing slash.
# Example: https://tenant-api.nawyorders.com
NEXT_PUBLIC_API_BASE_URL=

# Tenant slug issued with the customer account. Sent as X-Tenant-Id so the
# backend can reject a request that carries a token from another tenant.
NEXT_PUBLIC_TENANT_ID=

# The API returns devOtpCode only while it runs in dev/test. Set this to true on
# a preview deployment to surface that code in the copyable popup; production
# builds never show it, and a real SMS code is never sent to the browser.
NEXT_PUBLIC_SHOW_DEV_OTP=false
