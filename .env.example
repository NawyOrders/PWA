# NawyOrders tenant API — all of this is optional.
#
# With no base URL set the app is deliberately inert: every screen keeps using
# the local demo data in src/lib/data.ts and the login flow stays a pure
# front-end demo. Nothing is fetched and no token is stored.
#
# The tenant is resolved by the API from the request host, so this file has no
# tenant id and the client never sends an X-Tenant-Id header. The host must be
# the tenant-specific one, with the FULL slug from platform configuration:
#
#   https://{tenant-slug}.api.nawyorders.com
#   https://tahrir-01a1ad3c89d47d70876527c9ef863dcc.api.nawyorders.com
#
# Do not shorten the slug to the restaurant name. A wrong host answers
# 404 "Tenant Not Found" or 401 Tenant.Unresolved, and no header can fix that.

# Base URL of the tenant API, no trailing slash (slashes are stripped anyway).
# Either name works: next.config.ts folds TENANT_API_BASE_URL into the browser
# bundle, and the BFF reads it directly. When both are set the NEXT_PUBLIC_ one
# wins, so the browser and the app server cannot end up on different tenants.
# Unset, the client falls back to the full-slug host above but stays in demo
# mode — a deploy has to name a backend to go live.
#
# Set it BEFORE `next build`. The browser half is inlined into the bundle at
# build time, so changing it only in the runtime environment moves the app
# server to a new tenant while the page keeps calling the old one.
NEXT_PUBLIC_TENANT_API_BASE_URL=
TENANT_API_BASE_URL=

# Simulate the documented customer-login contract in the browser (success and
# every documented error: 429 + Retry-After, 422 wrong code, 409 max attempts,
# 404 unknown phone, refresh rotation and reuse detection). No network call
# leaves the page. Read by a dev/test build only — a production build ignores
# this flag and cannot reach the simulator at all.
#
# NEXT_PUBLIC_ is what makes the flag reach the browser bundle; the bare name is
# honoured too, for server-side tests that set process.env directly.
NEXT_PUBLIC_AUTH_MOCK=false
AUTH_MOCK=false

# No flag is needed for the code popup: when the API returns devOtpCode in the
# OTP-request response (dev/test tenants only), the login screen captures that
# code into the copyable popup on every deploy. A backend that sends no code
# shows no popup, and a real SMS code is never sent to the browser.

# Leave this false to keep the app's own palette. Setting it to true lets the
# restaurant's Branding colours (primaryColor, accentColor, backgroundColor…)
# repaint the theme and the browser chrome on every screen. Branding is still
# fetched and cached either way, so the name and contact details stay available.
NEXT_PUBLIC_APPLY_TENANT_COLORS=false
