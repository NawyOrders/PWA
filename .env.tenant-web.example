# Runtime configuration for the customer storefront.
#
# Copy to `.env.tenant-web` on the VPS and restart the container. This file is
# never committed. Nothing here is baked into the image: the same image serves
# every tenant.

# The storefront is served from `{slug}.nawyorders.com`. The first hostname
# label is the tenant slug.
TENANT_ROOT_DOMAIN=nawyorders.com

# The tenant API host for a resolved slug. `{slug}` is mandatory; a template
# without it is treated as a configuration error rather than falling back to one
# store.
TENANT_API_BASE_URL_TEMPLATE=https://{slug}.api.nawyorders.com

# Host labels that must never be treated as a store. Comma-separated; replaces
# the built-in list when set.
TENANT_RESERVED_SLUGS=www,api,admin,platform-api,tenant-api,app,static,assets,health,cdn,media,dashboard

# Optional. Leave unset to keep the built-in Nawy palette. Set to `true` only
# when tenants should repaint the storefront with their own colours. This is a
# build-time browser flag in the current theme layer.
# NEXT_PUBLIC_APPLY_TENANT_COLORS=true
